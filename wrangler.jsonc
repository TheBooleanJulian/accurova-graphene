// Accurova Graphene — static site on Cloudflare Workers (assets only, no server code).
// Deployed by Workers Builds on every push to main:
//   build:  npm ci && npm run sample:prepare && npm run build
//   deploy: npx wrangler deploy
// The editor runs entirely in the browser; there are no bindings or secrets.
{
  "name": "accurova-graphene",
  "account_id": "c580c4403524273d1bece674117472dd",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "graphene.accurova.com", "custom_domain": true }]
}
