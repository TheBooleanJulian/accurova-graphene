{
  "name": "accurova-graphene",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Accurova Graphene: a layer-based, browser-only graphic editor that composes designs from authentic, unmodified source assets.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\"",
    "test:e2e": "node --experimental-strip-types --no-warnings tests/e2e/run.mjs",
    "icons": "node scripts/build-icons.mjs",
    "sample:prepare": "node scripts/prepare-sample.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-static": "^1.77.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
